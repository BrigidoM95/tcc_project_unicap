# Desenvolvimento local. Gere uma chave com scripts/configurar.py.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,[::1]
DJANGO_TIME_ZONE=America/Campo_Grande
RESERVA_ABRE_AS=08:00
DB_ENGINE=sqlite
# Para PostgreSQL, altere DB_ENGINE e preencha:
POSTGRES_DB=unicap
POSTGRES_USER=unicap
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DJANGO_CORS_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_BEHIND_PROXY=false
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
